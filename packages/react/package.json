{
  "name": "@enterstellar/react",
  "description": "React integration — Provider, Zone, lifecycle management, render cache, and hooks.",
  "version": "0.1.1",
  "author": "Enterstellar",
  "license": "Apache-2.0",
  "homepage": "https://enterstellar.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/enterstellar/enterstellar.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/enterstellar/enterstellar/issues"
  },
  "keywords": [
    "react",
    "zone",
    "hooks",
    "generative-ui",
    "enterstellar"
  ],
  "type": "module",
  "private": false,
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "LICENSE",
    "NOTICE",
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@enterstellar/types": "workspace:*",
    "@enterstellar/registry": "workspace:*",
    "@enterstellar/compiler": "workspace:*",
    "@enterstellar/state": "workspace:*",
    "@enterstellar/telemetry": "workspace:*",
    "@enterstellar/connection": "workspace:*",
    "@enterstellar/cache": "workspace:*",
    "@enterstellar/lifecycle": "workspace:*",
    "@enterstellar/adapters": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "@testing-library/react": "^16.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "jsdom": "^28.1.0",
    "zod": "^4.3.6"
  }
}
