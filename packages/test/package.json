{
  "name": "@enterstellar/test",
  "description": "Intent-based testing framework — deterministic harness, assertion helpers, VCR fixtures.",
  "version": "0.1.1",
  "author": "Enterstellar",
  "license": "Apache-2.0",
  "homepage": "https://enterstellar.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/enterstellar-ai/enterstellar.git",
    "directory": "packages/test"
  },
  "bugs": {
    "url": "https://github.com/enterstellar-ai/enterstellar/issues"
  },
  "keywords": [
    "testing",
    "vitest",
    "harness",
    "generative-ui",
    "enterstellar"
  ],
  "type": "module",
  "private": false,
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "LICENSE",
    "NOTICE",
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@enterstellar/types": "workspace:*",
    "@enterstellar/registry": "workspace:*",
    "@enterstellar/compiler": "workspace:*",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@enterstellar/types": "workspace:*",
    "@enterstellar/registry": "workspace:*",
    "@enterstellar/compiler": "workspace:*",
    "@types/node": "^25.5.0",
    "vitest": "^4.1.8"
  }
}
